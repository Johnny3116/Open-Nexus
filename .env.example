# Copy to .env and fill in. NEVER commit the real .env.
# All secrets are server-side only — channel adapters and the web/desktop UI
# talk to Core, never directly to Supabase or to providers. See docs/SECURITY.md.

# ---------------------------------------------------------------------------
# Providers (set at least one)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Local / Ollama is OpenAI-compatible; point at its base URL instead of a key
LOCAL_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Supabase / Postgres  (server-side only — never ship the service-role key
# to any client)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (for migrations / pgvector / FTS)
DATABASE_URL=

# Embedding model used to populate messages.embedding (dimension must match
# the schema's vector(N)). Hosted to start; move local later if cost/privacy bites.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------------------------------------------------------------------------
# Channels (only what you enable)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ---------------------------------------------------------------------------
# Senses / special tools
# ---------------------------------------------------------------------------
VTUBE_STUDIO_WS=ws://localhost:8001
# Whisper STT: 'local' or a hosted endpoint
STT_BACKEND=local

# ---------------------------------------------------------------------------
# Delegation
# ---------------------------------------------------------------------------
JARVIS_ENDPOINT=
