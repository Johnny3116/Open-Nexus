# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).
# All secrets are server-side only — channels, the widget, and the web UI talk to
# Core, never directly to a provider or Supabase. See docs/nexus-build-plan.md §9.
#
# Phase 0 needs NONE of these: the default `echo` provider + SQLite require no
# keys. These are for when you wire real providers / Supabase.

# --- providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local / Ollama is OpenAI-compatible; no key, just a base URL.
LOCAL_BASE_URL=http://localhost:11434/v1

# --- Supabase (Phase 1+; service-role key is server-side ONLY) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- channels (Phase 5) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
